    "jsdom": "30.0.1",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10"
