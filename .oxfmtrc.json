{
  "printWidth": 100,
  "tabWidth": 2,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "semi": true,
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "sortImports": true,
  "sortTailwindcss": { "functions": ["cn", "clsx", "cva"] },
  "ignorePatterns": ["dist/**", "coverage/**", "pnpm-lock.yaml"]
}
