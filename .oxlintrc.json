{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["oxc", "typescript", "react", "jsx-a11y", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    // The automatic JSX runtime ("jsx": "react-jsx") means React needs no import.
    "react/react-in-jsx-scope": "off",
    "import/no-cycle": "error",
    // Stylesheet and font imports are side-effect imports by design.
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "@fontsource*/**", "**/jest-dom/**"] }
    ],
    "no-console": ["error", { "allow": ["warn", "error"] }],
    "no-unused-vars": ["error", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
  },
  "settings": {
    "jsx-a11y": {
      "components": { "Button": "button", "Link": "a" }
    }
  },
  "overrides": [
    {
      "files": ["src/lib/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "react",
                  "react-dom",
                  "react/*",
                  "react-dom/*",
                  "@base-ui/react",
                  "@base-ui/react/*",
                  "@/components",
                  "@/components/*",
                  "@/hooks",
                  "@/hooks/*",
                  "@/state",
                  "@/state/*",
                  "**/components/**",
                  "**/hooks/**"
                ],
                "message": "src/lib must stay framework-free and testable without rendering — see docs/DESIGN.md."
              }
            ]
          }
        ]
      }
    },
    {
      // Command-line tools. Printing to stdout is what they are for, and driving a browser
      // is a sequence — clicking a panel in parallel with itself is not a faster test.
      "files": ["scripts/**"],
      "rules": {
        "no-console": "off",
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx}", "**/test/**"],
      "plugins": ["vitest"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      // Vendored from the shadcn registry and re-written verbatim by `shadcn add`, so a
      // fix applied here is a fix that disappears. Their own house style is the one they
      // are maintained in; ours applies to the code we write.
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off",
        "react/jsx-no-constructed-context-values": "off",
        "jsx-a11y/label-has-associated-control": "off",
        // These render a control whose label is passed in as children by the caller. The
        // rule reads the empty tag in the registry's own source.
        "jsx-a11y/control-has-associated-label": "off",
        "no-underscore-dangle": "off"
      }
    }
  ]
}
